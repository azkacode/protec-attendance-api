PORT=3000

# Calendar/timezone used for attendance dates, weekdays, and timestamps.
ATTENDANCE_TIMEZONE=Asia/Jakarta

# Host port exposed by docker-compose. The application remains on port 3000 inside the container.
ATTENDANCE_API_PORT=3123

# The Docker network shared with the production MySQL container.
ATTENDANCE_MYSQL_NETWORK=protec

DBHOST=protec-api-mysql
DBUSER=root
DBNAME=name
DBPASS=secret
DBPORT=3306

JWTSECRET=secret

CLOUNINARY_CLOUD_NAME=cloudname
CLOUNINARY_API_KEY=apikey
CLOUNINARY_API_SECRET=apisecret

REDISURL=redis://localhost:6379

S3_ENDPOINT=https://nos.wjv-1.neo.id
S3_REGION=idn
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=protec-attendances
